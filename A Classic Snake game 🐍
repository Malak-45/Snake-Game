#include <iostream>
#include <vector>
#include <utility>
#include <conio.h>
#include <windows.h>
#include <cstdlib>
#include <ctime>
#include <fstream>

using namespace std;

class SnakeGame
{
private:
    const int width = 30;
    const int height = 15;

    vector<pair<int, int>> snake;

    int foodX, foodY;
    int score;
    int highScore;
    int speed;
    int level;

    bool gameOver;
    bool paused;

    enum Direction
    {
        STOP,
        LEFT,
        RIGHT,
        UP,
        DOWN
    };

    Direction direction;

public:
    SnakeGame()
    {
        srand(time(0));

        highScore = 0;
        LoadHighScore();
    }

    void LoadHighScore()
    {
        ifstream file("snake_record.txt");

        if (file.is_open())
        {
            file >> highScore;
            file.close();
        }
    }

    void SaveHighScore()
    {
        if (score > highScore)
        {
            highScore = score;

            ofstream file("snake_record.txt");

            if (file.is_open())
            {
                file << highScore;
                file.close();
            }
        }
    }

    void Setup()
    {
        snake.clear();

        int startX = width / 2;
        int startY = height / 2;

        // إنشاء الثعبان من 3 أجزاء
        snake.push_back(make_pair(startX, startY));
        snake.push_back(make_pair(startX - 1, startY));
        snake.push_back(make_pair(startX - 2, startY));

        direction = RIGHT;

        score = 0;
        level = 1;
        speed = 150;

        gameOver = false;
        paused = false;

        SpawnFood();
    }

    void SpawnFood()
    {
        bool onSnake;

        do
        {
            onSnake = false;

            foodX = rand() % width;
            foodY = rand() % height;

            for (int i = 0; i < snake.size(); i++)
            {
                if (snake[i].first == foodX &&
                    snake[i].second == foodY)
                {
                    onSnake = true;
                    break;
                }
            }

        } while (onSnake);
    }

    void Draw()
    {
        system("cls");

        // الحد العلوي
        for (int i = 0; i < width + 2; i++)
            cout << "#";

        cout << endl;

        // رسم الملعب
        for (int i = 0; i < height; i++)
        {
            cout << "#";

            for (int j = 0; j < width; j++)
            {
                bool printed = false;

                // رسم رأس الثعبان
                if (snake[0].first == j &&
                    snake[0].second == i)
                {
                    cout << "O";
                    printed = true;
                }

                // رسم باقي الجسم
                for (int k = 1; k < snake.size(); k++)
                {
                    if (snake[k].first == j &&
                        snake[k].second == i)
                    {
                        cout << "o";
                        printed = true;
                        break;
                    }
                }

                // رسم الأكل
                if (!printed && foodX == j && foodY == i)
                {
                    cout << "F";
                    printed = true;
                }

                if (!printed)
                    cout << " ";
            }

            cout << "#" << endl;
        }

        // الحد السفلي
        for (int i = 0; i < width + 2; i++)
            cout << "#";

        cout << endl;

        cout << "Score: " << score
             << " | High Score: " << highScore
             << " | Level: " << level << endl;

        cout << "Controls: W A S D | P: Pause | X: Exit" << endl;

        if (paused)
            cout << "\n*** PAUSED - Press P to Resume ***\n";
    }

    void ChangeDirection(Direction newDirection)
    {
        // منع عكس الاتجاه مباشرة
        if (direction == LEFT && newDirection == RIGHT)
            return;

        if (direction == RIGHT && newDirection == LEFT)
            return;

        if (direction == UP && newDirection == DOWN)
            return;

        if (direction == DOWN && newDirection == UP)
            return;

        direction = newDirection;
    }

    void Input()
    {
        if (!_kbhit())
            return;

        char key = _getch();

        // إيقاف اللعبة واستكمالها
        if (key == 'p' || key == 'P')
        {
            paused = !paused;
            return;
        }

        if (paused)
            return;

        switch (key)
        {
        case 'a':
        case 'A':
            ChangeDirection(LEFT);
            break;

        case 'd':
        case 'D':
            ChangeDirection(RIGHT);
            break;

        case 'w':
        case 'W':
            ChangeDirection(UP);
            break;

        case 's':
        case 'S':
            ChangeDirection(DOWN);
            break;

        case 'x':
        case 'X':
            gameOver = true;
            break;
        }
    }

    void Logic()
    {
        int newX = snake[0].first;
        int newY = snake[0].second;

        // تحديد مكان الرأس الجديد
        if (direction == LEFT)
            newX--;

        else if (direction == RIGHT)
            newX++;

        else if (direction == UP)
            newY--;

        else if (direction == DOWN)
            newY++;

        // التصادم مع الحائط
        if (newX < 0 || newX >= width ||
            newY < 0 || newY >= height)
        {
            gameOver = true;
            return;
        }

        bool ateFood = (newX == foodX && newY == foodY);

        // التصادم مع الجسم
        // لو مش بياكل، آخر جزء هيتحذف؛ لذلك لا نحتاج فحصه
        int bodyPartsToCheck = snake.size();

        if (!ateFood)
            bodyPartsToCheck--;

        for (int i = 0; i < bodyPartsToCheck; i++)
        {
            if (snake[i].first == newX &&
                snake[i].second == newY)
            {
                gameOver = true;
                return;
            }
        }

        // إضافة الرأس الجديد
        snake.insert(snake.begin(), make_pair(newX, newY));

        if (ateFood)
        {
            score += 10;

            // زيادة المرحلة كل 50 نقطة
            level = (score / 50) + 1;

            // زيادة السرعة مع كل مرحلة
            speed = 150 - ((level - 1) * 15);

            if (speed < 40)
                speed = 40;

            SpawnFood();
        }
        else
        {
            // حذف آخر جزء حتى يتحرك الثعبان
            snake.pop_back();
        }
    }

    void Play()
    {
        Setup();

        while (!gameOver)
        {
            Draw();
            Input();

            if (!gameOver && !paused)
                Logic();

            Sleep(speed);
        }

        Draw();

        cout << "\nGAME OVER!\n";
        cout << "Your Score: " << score << endl;

        SaveHighScore();

        cout << "High Score: " << highScore << endl;
        cout << "\nPress any key to return to the menu...";
        _getch();
    }

    void ChooseDifficulty()
    {
        int choice;

        cout << "\nChoose Difficulty\n";
        cout << "1. Easy\n";
        cout << "2. Medium\n";
        cout << "3. Hard\n";
        cout << "Your choice: ";
        cin >> choice;

        if (choice == 1)
            speed = 200;
        else if (choice == 2)
            speed = 150;
        else if (choice == 3)
            speed = 90;
        else
        {
            cout << "Invalid choice. Medium selected.\n";
            speed = 150;
        }
    }

    void MainMenu()
    {
        int choice;

        do
        {
            system("cls");

            cout << "============================\n";
            cout << "       SNAKE GAME\n";
            cout << "============================\n";
            cout << "1. Play Game\n";
            cout << "2. Choose Difficulty\n";
            cout << "3. Show High Score\n";
            cout << "4. Exit\n";
            cout << "============================\n";
            cout << "Enter your choice: ";
            cin >> choice;

            if (choice == 1)
            {
                Play();
            }
            else if (choice == 2)
            {
                ChooseDifficulty();
                cout << "\nDifficulty saved. Press any key...";
                _getch();
            }
            else if (choice == 3)
            {
                system("cls");
                cout << "High Score: " << highScore << endl;
                cout << "\nPress any key to return...";
                _getch();
            }
            else if (choice == 4)
            {
                cout << "\nThanks for playing!\n";
            }
            else
            {
                cout << "\nInvalid choice. Press any key...";
                _getch();
            }

        } while (choice != 4);
    }
};

int main()
{
    SnakeGame game;

    game.MainMenu();

    return 0;
}